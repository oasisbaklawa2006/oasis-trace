# Oasis Label Studio (Barcode App) — copy to .env (never commit .env)
VITE_SUPABASE_URL=https://YOUR-OASIS-CENTRAL-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Show "Submit to Central" UI after verified scans (requires deployed edge function)
VITE_CENTRAL_SCAN_SUBMIT_ENABLED=false

# Edge function secrets (set in Supabase dashboard — NOT in frontend):
# SUPABASE_SERVICE_ROLE_KEY
# CENTRAL_SCAN_INGEST_URL=https://central.example.com/api/operational_scan_records
# CENTRAL_SCAN_SIGNING_SECRET=your-hmac-secret
